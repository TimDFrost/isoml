# Site
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Scheduling (leave empty for honest "unavailable" schedule page)
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-link

# Early access capture (optional webhook; otherwise server log only)
# EARLY_ACCESS_WEBHOOK_URL=

# LLM — server-only; used by /api/chat and /api/demo
# OPENAI_API_KEY=
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Reachy Mini hardware adapter boundary (server-only)
# Do not set this unless you have a verified endpoint/SDK path.
# REACHY_MINI_ENDPOINT=

# Optional future auth/data store
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
